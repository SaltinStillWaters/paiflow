# ---- App ----
# NODE_ENV is set by next-build itself; leave unset locally
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- Auth ----
# Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_RP_ID=localhost
AUTH_RP_NAME=Paiflow
ALLOW_PUBLIC_REGISTRATION=false
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# ---- Database ----
DATABASE_URL=postgresql://paiflow:paiflow@localhost:5432/paiflow?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- File storage (dev = MinIO; prod = Railway Volume) ----
FILE_STORAGE_DRIVER=minio
FILE_STORAGE_PATH=/data/files
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=paiflow
MINIO_SECRET_KEY=paiflow-dev-secret
MINIO_BUCKET=paiflow-dev

# ---- Stellar ----
# Network is pinned per environment:
#   - dev / staging → STELLAR_NETWORK=testnet
#   - production    → STELLAR_NETWORK=mainnet
# There is no per-deploy picker. Switch environments by switching this var.
STELLAR_NETWORK=testnet

# Testnet endpoints (required when STELLAR_NETWORK=testnet)
STELLAR_NETWORK_PASSPHRASE_TESTNET=Test SDF Network ; September 2015
STELLAR_HORIZON_URL_TESTNET=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
# Friendbot is testnet-only (leave empty/unset when STELLAR_NETWORK=mainnet).
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Mainnet endpoints (required when STELLAR_NETWORK=mainnet). The defaults
# below are SDF's public endpoints — uncomment / override only if you run
# your own RPC.
# STELLAR_NETWORK_PASSPHRASE_MAINNET=Public Global Stellar Network ; September 2015
# STELLAR_HORIZON_URL_MAINNET=https://horizon.stellar.org
# STELLAR_SOROBAN_RPC_URL_MAINNET=https://mainnet.sorobanrpc.com

# Populated by `pnpm contracts:upload --network=testnet`
STELLAR_WASM_HASH_SPLITTER_TESTNET=
STELLAR_WASM_HASH_STREAMER_TESTNET=
STELLAR_WASM_HASH_CONDITIONAL_TESTNET=
STELLAR_WASM_HASH_DEPOSIT_TRIGGER_TESTNET=
STELLAR_WASM_HASH_ROUTER_TESTNET=
STELLAR_WASM_HASH_TIMELOCK_TESTNET=
STELLAR_WASM_HASH_WEBHOOK_TESTNET=
STELLAR_WASM_HASH_SUBSCRIPTION_TESTNET=
STELLAR_WASM_HASH_ORACLE_TESTNET=
STELLAR_WASM_HASH_MULTISIG_TESTNET=
STELLAR_WASM_HASH_SWAPPER_TESTNET=
STELLAR_WASM_HASH_YIELD_TESTNET=
STELLAR_WASM_HASH_PAYER_TESTNET=
STELLAR_WASM_HASH_CASH_OUT_TESTNET=
# Populated by `pnpm contracts:upload --network=mainnet` (see docs/mainnet-cutover.md)
STELLAR_WASM_HASH_SPLITTER_MAINNET=
STELLAR_WASM_HASH_STREAMER_MAINNET=
STELLAR_WASM_HASH_CONDITIONAL_MAINNET=
STELLAR_WASM_HASH_DEPOSIT_TRIGGER_MAINNET=
STELLAR_WASM_HASH_ROUTER_MAINNET=
STELLAR_WASM_HASH_TIMELOCK_MAINNET=
STELLAR_WASM_HASH_WEBHOOK_MAINNET=
STELLAR_WASM_HASH_SUBSCRIPTION_MAINNET=
STELLAR_WASM_HASH_ORACLE_MAINNET=
STELLAR_WASM_HASH_MULTISIG_MAINNET=
STELLAR_WASM_HASH_SWAPPER_MAINNET=
STELLAR_WASM_HASH_YIELD_MAINNET=
STELLAR_WASM_HASH_PAYER_MAINNET=
STELLAR_WASM_HASH_CASH_OUT_MAINNET=

# ---- Relayer (auto-release) ----
# Secret key of the account that calls release_by_relayer on timelock contracts.
# Optional; when unset timelock contracts fall back to admin-only release.
# The account must be funded so it can pay transaction fees.
STELLAR_RELAYER_SECRET_KEY=

# ---- Cron ----
CRON_SECRET=

# ---- AI / Raft Log ----
# Generic OpenAI-compatible provider
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Groq provider (recommended for Raft Log)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL_PRIMARY=whisper-large-v3
GROQ_STT_MODEL_FALLBACK=whisper-large-v3-turbo

# ---- Email (Resend) ----
# Optional in dev: when RESEND_API_KEY is unset, lib/mail.ts logs the email
# payload to stdout instead of delivering. Required in prod for password
# reset to actually send. Sign up at https://resend.com.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's onboarding@resend.dev (test-only —
# delivers to your verified Resend account inbox only).
EMAIL_FROM=

# ---- Off-ramp provider (e.g. PDAX) ----
# Provider: "mock" for local dev/tests, "pdax" for PDAX Institutional API UAT.
OFFRAMP_PROVIDER=mock
#
# Temporary hard limits on fixed split/pay amounts and off-ramp job sizes.
# These are public because flow validation runs in the browser. Values are
# whole tokens (XLM / USDC) and are converted to stroops at runtime.
NEXT_PUBLIC_SPLITTER_XLM_MIN=150
NEXT_PUBLIC_SPLITTER_XLM_MAX=500
NEXT_PUBLIC_SPLITTER_USDC_MIN=30
NEXT_PUBLIC_SPLITTER_USDC_MAX=110
# OFFRAMP_PROVIDER=pdax
# OFFRAMP_API_URL=https://uat.services.sandbox.pdax.ph/api/pdax-api
#
# PDAX tokens rotate frequently. Store the current access/id tokens in the
# database via Admin → Off-ramp (/admin/offramp). The refresh token must live
# ONLY in this env var, never in the database.
# OFFRAMP_USERNAME=
# OFFRAMP_ACCESS_TOKEN=
# OFFRAMP_ID_TOKEN=
# OFFRAMP_REFRESH_TOKEN=
# OFFRAMP_WEBHOOK_SECRET=
# PDAX defaults (production and UAT institutional wallets both use USDC;
# Stellar USDC / USDCXLM deposits are disabled in UAT):
# OFFRAMP_ASSET_CODE=USDC
# OFFRAMP_NETWORK=XLM_USDC_T_CEKS
# OFFRAMP_CHANNEL=InstaPay
# Native XLM PDAX deposit credentials. When both address and memo are set,
# process-offramp-jobs will forward XLM from the treasury to PDAX before
# quoting/trading. The memo is the numeric tag PDAX requires to credit the
# deposit to your institutional balance.
# OFFRAMP_PDAX_DEPOSIT_ADDRESS_TESTNET=GCK2MUVH6TABTXT4247CIEC5EO24CQQ4MZNW7EGBTP3TPGALLQI7P34G
# OFFRAMP_PDAX_DEPOSIT_MEMO_TESTNET=3777239912
# OFFRAMP_PDAX_DEPOSIT_ADDRESS_MAINNET=
# OFFRAMP_PDAX_DEPOSIT_MEMO_MAINNET=
#
# IMPORTANT: PDAX UAT cannot accept Stellar USDC (USDCXLM) deposits. The
# employer must pre-fund the PDAX institutional balance with USDC off-chain.
# The on-chain treasury still sinks Stellar USDC as a bookkeeping proof.
# For native XLM, use the PDAX deposit credentials above instead.
#
# PDAX UAT test beneficiary bank accounts (reference only — NOT read by the app;
# bank details are entered per-recipient in the flow config). Use these valid
# sandbox accounts to avoid AC01 (incorrect account number) rejections:
#   BASECPH (Security Bank)  -> 0000042001461
#   BACTBPH (CTBC Bank PH)   -> 001700062270

# ---- Optional ----
SENTRY_DSN=
HIBP_CHECK_ENABLED=false
