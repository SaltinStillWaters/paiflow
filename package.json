{
  "name": "pinkraft",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.11 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && DATABASE_URL=\"${DATABASE_URL:-postgresql://dummy:dummy@localhost:5432/dummy?schema=public}\" AUTH_SECRET=\"${AUTH_SECRET:-build-time-dummy-secret-32-chars-long-aaaaaa}\" next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=chromium-desktop screenshots.spec.ts",
    "screenshots:mobile": "playwright test --project=mobile screenshots.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "contracts:build": "cd contracts && cargo build --release --target wasm32v1-none",
    "contracts:upload": "tsx scripts/upload-wasm.ts",
    "docker:up": "docker compose --profile full up -d",
    "docker:down": "docker compose down -v",
    "prepare": "husky || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "@tanstack/react-query": "^5.62.7",
    "@walletconnect/modal": "2.6.2",
    "@walletconnect/sign-client": "2.11.2",
    "@xyflow/react": "^12.4.1",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.15.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.469.0",
    "minio": "^8.0.3",
    "next": "^15.1.3",
    "next-auth": "5.0.0-beta.25",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0-beta.8",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0-beta.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
